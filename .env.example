# Supabase Configuration
# Copy this file to .env.local (or .env) and fill in your values from:
# Supabase Dashboard -> Project Settings -> API

# IMPORTANT: Always use the 'anon' (public) key for client-side applications.
# NEVER use or commit the 'service_role' secret key!

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Mapbox Configuration
# Public token from https://account.mapbox.com/access-tokens/
# Ask a teammate for the shared team token (safe to reuse — client-side public token).
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token-here
