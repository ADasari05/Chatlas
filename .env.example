# Supabase Configuration
# Copy this file to .env.local (or .env) and fill in your values from:
# Supabase Dashboard -> Project Settings -> API

# Client-side Public Key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Server-side Secret Key (Admin / Service Role)
# Required ONLY on the server for administrative user deletion and management.
# NEVER prefix with NEXT_PUBLIC_ or commit to version control!
SUPABASE_SECRET_KEY=your-secret-key-here
# (Note: Legacy projects using JWT keys can also use SUPABASE_SERVICE_ROLE_KEY)

# Mapbox Configuration
# Public token from https://account.mapbox.com/access-tokens/
# Ask a teammate for the shared team token (safe to reuse — client-side public token).
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token-here
